{
  "name": "traitor-radar",
  "version": "1.0.0",
  "description": "An automated Telegram loyalty tracker using Cloudflare Workers & D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute traitor-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute traitor-db --remote --file=./schema.sql",
    "sync:members": "npx ts-node scripts/sync-members.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "input": "^1.0.1",
    "telegram": "^2.22.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.114.17"
  }
}
